{
  "multipart": [
    { "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "backrooms_complex:block/dust_dot" } },

    { "when": { "north": "true" },
      "apply": { "model": "backrooms_complex:block/dust_side0" } },
    { "when": { "east": "true" },
      "apply": { "model": "backrooms_complex:block/dust_side1", "y": 90 } },
    { "when": { "south": "true" },
      "apply": { "model": "backrooms_complex:block/dust_side0", "y": 180 } },
    { "when": { "west": "true" },
      "apply": { "model": "backrooms_complex:block/dust_side1", "y": 270 } }
  ]
}